# Copy file này thành ".env" (KHÔNG commit ".env" lên git) rồi điền giá trị thật.

# --- PostgreSQL (container "db" trong docker-compose.yml) ---
POSTGRES_DB=dkstore
POSTGRES_USER=dkstore
POSTGRES_PASSWORD=change_me_strong_password

# --- Datasource cho app (service name "db" là host nội bộ trong docker network) ---
DB_URL=jdbc:postgresql://db:5432/dkstore
DB_USERNAME=dkstore
DB_PASSWORD=change_me_strong_password

# --- Cloudinary (giữ nguyên tài khoản hiện tại, lấy từ dashboard Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Gmail SMTP (giữ nguyên tài khoản hiện tại) ---
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --- URL công khai của app, dùng để build link xác thực email / reset password ---
# Phải là domain thật (đã trỏ qua Cloudflare Tunnel), có https://
APP_BASE_URL=https://your-domain.com

# --- Cloudflare Tunnel token (lấy từ Zero Trust dashboard khi tạo tunnel) ---
TUNNEL_TOKEN=your_cloudflare_tunnel_token
